# Database Configuration
DB_URL=jdbc:mysql://127.0.0.1:3306/jobsportal?useSSL=false&serverTimezone=UTC
DB_USER=root
DB_PASSWORD=your-db-password

# Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_AUTH=true
SMTP_STARTTLS=true

# Application URL
APP_BASE_URL=http://localhost:8080/JobsPortalAssignment

# OAuth Configurations (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
